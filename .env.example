# Only needed to run the app on your computer with your Supabase database.
# Copy this file to .env.local (never commit it) and paste your two values from
# Supabase: click "Connect" at the top of your project, or Project Settings > API Keys.
# Leave both empty to keep everything in your browser instead (no account needed).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: the Assistant panel. Server-side only, so no VITE_ prefix (it must never reach the browser).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
